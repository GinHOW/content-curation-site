{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "content-curation-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-curation-site",
      "database_id": "18b18af9-3846-4265-9725-a1c53609d9cd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESOURCE_IMAGES",
      "bucket_name": "caa"
    }
  ]
}
